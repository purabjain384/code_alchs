# ============================================================================
# 1. GEMINI AI CONFIGURATION (Required for Bilingual Hindi/EN, Vision OCR & Audio)
# Get from: https://aistudio.google.com/apikey
# ============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash

# ============================================================================
# 2. FIREBASE & GOOGLE CLOUD TTS CREDENTIALS (Required for Firestore & Audio)
# Download from: Firebase Console -> Project Settings -> Service Accounts
# Save JSON inside c:\Folder\Code\gdg\backend\ as serviceAccountKey.json
# Make sure "Cloud Text-to-Speech API" is enabled in Google Cloud Console!
# ============================================================================
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# ============================================================================
# 3. ML TEAMMATE MODEL HANDOFF (Optional until ML teammate drops in their file)
# Expected input features order: [Age, SystolicBP, DiastolicBP, BS, BodyTemp, HeartRate]
# If this file is not present yet, risk_engine.py uses a calibrated UCI fallback automatically.
# ============================================================================
MODEL_PATH=rf_model.joblib

# ============================================================================
# 4. OVERALL VISIT HISTORY TREND LIMIT
# Fetches up to N past visits for overall maternal trajectory analysis (not hardcoded to 3)
# ============================================================================
MAX_HISTORY_VISITS=50

# ============================================================================
# 5. LOCAL DEV / OFFLINE TOGGLE
# Set to "true" to bypass live Gemini & Cloud TTS API calls during offline testing
# ============================================================================
USE_MOCK_AI=false

